# Flask
SECRET_KEY=replace-with-a-long-random-secret

# Database (SQLAlchemy)
# Example for MySQL + PyMySQL:
DATABASE_URL=mysql+pymysql://user:password@localhost/book_reader?charset=utf8mb4

# Gmail SMTP (prefer an App Password with 2FA enabled)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_SENDER_NAME=BookInPieces

# App timezone
APP_TIMEZONE=Europe/Rome

# Session timeout after inactivity (minutes)
SESSION_INACTIVITY_MINUTES=10


# Auth rate limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
FORGOT_PASSWORD_RATE_LIMIT_ATTEMPTS=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=600
REGISTER_RATE_LIMIT_ATTEMPTS=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# Redis storage for shared rate limiting across Gunicorn workers
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# Maximum upload file size in MB (default: 10)
MAX_UPLOAD_SIZE_MB=10
